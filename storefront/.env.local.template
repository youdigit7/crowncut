# Your Medusa backend URL
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key from Medusa Admin (Settings -> Publishable API Keys) or from db seed
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_api_key_here

# Your store URL
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Your preferred default region (e.g., us, dk, etc.)
NEXT_PUBLIC_DEFAULT_REGION=us

# MinIO endpoint for image storage (optional)
# NEXT_PUBLIC_MINIO_ENDPOINT=bucket-production-eaeb.up.railway.app

# MeiliSearch Configuration (optional)
# NEXT_PUBLIC_SEARCH_ENDPOINT=http://localhost:7700
# NEXT_PUBLIC_SEARCH_API_KEY=your_search_key_here
# NEXT_PUBLIC_INDEX_NAME=products
